{
	"name": "bhvr-fullstack-template",
	"version": "0.0.1",
	"description": "A fullstack template built built on BHVR foundation that adds db, authentication, and custom components and configs",
	"author": "David Moriarty",
	"repository": {
		"type": "git",
		"url": "https://github.com/davidmoriarty/bhvr-fullstack-template.git"
	},
	"license": "MIT",
	"engines": {
		"bun": ">= 1.3.9"
	},
	"packageManager": "bun@1.3.9",
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md,yml,yaml}": [
			"biome check --write"
		]
	},
	"workspaces": [
		"./server",
		"./client",
		"./shared"
	],
	"scripts": {
		"template:apply": "bun ./scripts/apply-template.ts",
		"prepare": "husky",
		"precommit": "lint-staged",
		"lint": "biome check .",
		"fmt": "biome format . --write",
		"type-check": "turbo run type-check",
		"test": "turbo run test",
		"dev": "turbo dev",
		"build": "turbo build",
		"dev:client": "turbo dev --filter=client",
		"dev:server": "turbo dev --filter=server",
		"build:client": "turbo build --filter=client",
		"build:server": "turbo build --filter=server",
		"deploy:client": "",
		"deploy:server": ""
	},
	"keywords": [
		"bun",
		"hono",
		"jwt-authentication",
		"monorepo",
		"postgreSQL",
		"react",
		"shadcn-ui",
		"tailwind",
		"tanstack-router",
		"turbo",
		"vite"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.4.3",
		"@tanstack/react-query-devtools": "^5.91.3",
		"bun-types": "latest",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"turbo": "^2.8.10"
	},
	"peerDependencies": {
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"hono": "^4.12.0"
	}
}
